# scripts/setup-env.sh copies this to .env (and generates POSTGRES_PASSWORD, POSTGRES_APP_PASSWORD and POSTGRES_RESTORE_PASSWORD); adjust, then: docker compose up -d --build
# --- address and port --------------------------------------------------------------------------
PORT=8095                                   # https on the host (served by the bundled nginx)
# BIND=0.0.0.0                              # reachable from the network (default: this machine only) – docs/BETRIEB.md
# BASE_URL=https://news.corp.example:8095   # the address people type – links in notifications, Entra redirect URI
# NEWS_HOSTNAME=news.corp.example           # name in the self-signed certificate
# TLS_NAMES=10.0.0.5                        # more names/IPs in it, comma separated – nginx answers only to these, BASE_URL's and localhost
# --- certificate ------------------------------------------------------------------------------
# TLS_MODE=own                              # selfsigned (default) | own | external
# TLS_SOURCE=./deploy/certs                 # with own: folder with cobe.crt (+ chain) and cobe.key
# HSTS=1                                    # also with the self-signed one, once it is trusted everywhere
# --- own reverse proxy in front ---------------------------------------------------------------
# PROXY_ENABLED=0
# TLS_MODE=external
# TRUSTED_PROXIES=172.31.250.1/32           # own proxy on the host: the gateway of the network edge (docs/BETRIEB.md); never with PROXY_ENABLED=1
# SHARED_ADDRESSES=192.0.2.10               # addresses many people share (office NAT) – never blocked, slowed instead (docs/BETRIEB.md)
# --- secrets and outbound ---------------------------------------------------------------------
# SECRET_KEY=<long random string>           # at least 32 random characters (openssl rand -base64 32); else a key file in ./data/secret.key
# WEBHOOK_HOSTS=chat.corp.example           # own webhook hosts besides Teams/Slack
# SMTP_ALLOW_INTERNAL=172.31.250.1          # SMTP relay on the Docker host behind the gateway (otherwise refused, docs/BETRIEB.md)
# WEBHOOK_PRIVATE_NETS=10.20.0.0/16         # private addresses/networks channels may post to (n8n next door) – never loopback/link-local
# HTTPS_PROXY=http://proxy.corp.example:3128
# CA_FILE=/data/ca.pem                      # own CA bundle (PEM): put the file into ./data/ca.pem
# ALLOW_PRIVATE_FEEDS=1
# MAX_BODY_BYTES=1048576                    # largest request body the app takes (behind nginx's 1 MB) – 413 above it
# --- Web Push (desktop notifications with the tab closed; docs/BETRIEB.md: Web Push) ---------------------
# WEB_PUSH=0                       # off: no requests to the browsers' push services (tabs still notify)
# PUSH_CONTACT=mailto:secops@corp.example
# --- optional http → https redirect -----------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.http.yml
# HTTP_PORT=8094
# --- optional: the released image instead of a local build (docs/BETRIEB.md: Veröffentlichtes Image) ---------
# COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml   # with the redirect: …:docker-compose.http.yml:docker-compose.image.yml
# COBE_NEWS_IMAGE=ghcr.io/g0urmetd/cobe-news:0.1.47          # a released version (or …@sha256:<digest>) – check it with cosign first
# --- database and backups (docs/BETRIEB.md: PostgreSQL, Sicherung) ---------------------------------------
# POSTGRES_PASSWORD=                         # superuser (only db-init uses it) – generated by scripts/setup-env.sh, keep it
# POSTGRES_APP_PASSWORD=                     # the app's role cobe_news_app (no superuser) – generated by scripts/setup-env.sh
# POSTGRES_RESTORE_PASSWORD=                 # the restore test's own role (throwaway database only) – generated by scripts/setup-env.sh; empty: no restore test
# DB_MEM=512m                               # memory limit of the database container
# BACKUP_PASSPHRASE=<long passphrase>       # backups encrypted and with the key – better passed only to the cron job
# SQLITE_IMPORT=0                           # never import data/news.db (0.1.15) into an empty database at the start
