{
  "$comment": "Generated by `python -m app.catalog_data --write-schema` – do not edit (build_map_names.schema.json)",
  "$defs": {
    "NameRow": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "names": {
          "description": "What admins see or type for it.",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Names",
          "type": "array"
        },
        "value": {
          "description": "What is stored and compared, in the product's version scheme.",
          "maxLength": 40,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "names"
      ],
      "title": "NameRow",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "build_maps/<name>.yaml of kind names: typed names → the value compared (Exchange CU/SU → build …).",
  "properties": {
    "claims": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Regular expression: a text of this form must be in the table – else it is refused (unknown_name).",
      "title": "Claims"
    },
    "extract": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Regular expression with one group: a version inside a longer text, taken as it is.",
      "title": "Extract"
    },
    "fetched": {
      "description": "When the table was taken from its sources.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Fetched",
      "type": "string"
    },
    "hint": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9_]{1,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Key of a text in texts.yaml (hints) shown when a name is not in the table.",
      "title": "Hint"
    },
    "kind": {
      "const": "names",
      "title": "Kind",
      "type": "string"
    },
    "products": {
      "description": "The catalogue products it is for.",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Products",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/NameRow"
      },
      "maxItems": 3000,
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "sources": {
      "description": "Where the table comes from (official pages).",
      "items": {
        "maxLength": 300,
        "minLength": 8,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "strip": {
      "default": [],
      "description": "Words dropped before a name is looked up (the product's own name).",
      "items": {
        "pattern": "^[a-z0-9]{1,30}$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Strip",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "fetched",
    "sources",
    "products",
    "rows"
  ],
  "title": "NamesMapFile",
  "type": "object"
}
