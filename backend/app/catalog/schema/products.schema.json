{
  "$comment": "Generated by `python -m app.catalog_data --write-schema` – do not edit (products.schema.json)",
  "$defs": {
    "Belongs": {
      "additionalProperties": false,
      "description": "A typed version of this form is another product's (pfSense Plus 24.11 typed for pfSense CE).",
      "properties": {
        "pattern": {
          "description": "Regular expression (Python, searched) on the typed version.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "to": {
          "description": "Key of the product it belongs to.",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "to"
      ],
      "title": "Belongs",
      "type": "object"
    },
    "Edition": {
      "additionalProperties": false,
      "description": "One edition of a product whose editions share version numbers (SharePoint 2016/2019/SE are all 16.0.x): a CVE\nrecord's row for an edition – its product name contains all words of `name` – only speaks for builds in its range.",
      "properties": {
        "below": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First build after the edition (none: open).",
          "title": "Below"
        },
        "cpe": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The edition in NVD's CPE (version or sw_edition field), e.g. 2019 or subscription.",
          "title": "Cpe"
        },
        "from": {
          "description": "First build of the edition, e.g. 16.0.10000.",
          "maxLength": 200,
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "name": {
          "description": "Words of the edition in CNA product names, e.g. '2019' or 'Subscription Edition'.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "from"
      ],
      "title": "Edition",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "description": "One product of the catalogue (or, without label, a patch of an endoflife.date product).",
      "properties": {
        "adv": {
          "anyOf": [
            {
              "enum": [
                "paloalto",
                "fortinet",
                "veeam"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vendor's structured advisories.",
          "title": "Adv"
        },
        "aliases": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other names the catalogue search finds.",
          "title": "Aliases"
        },
        "belongs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Belongs"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typed versions of another product's form (split products).",
          "title": "Belongs"
        },
        "cloud": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A service without a version on the customer side (scheme must be cloud).",
          "title": "Cloud"
        },
        "cna": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[vendor, product] in the CNA data of CVE records.",
          "title": "Cna"
        },
        "cpe_editions": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[cpe, sw_edition]: only NVD CPE matches of these editions count for that CPE (Firefox '-' vs 'esr', Jenkins 'lts').",
          "title": "Cpe Editions"
        },
        "cpes": {
          "default": [],
          "description": "NVD CPE short form part:vendor:product, e.g. o:fortinet:fortios.",
          "items": {
            "maxLength": 200,
            "pattern": "^[aoh]:(?:[^:\\s*?\\\\]|\\\\.)+:(?:[^:\\s*?\\\\]|\\\\.)+$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Cpes",
          "type": "array"
        },
        "depth": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parts of a complete version where endoflife.date has none or odd ones (fewer: 'ungenau').",
          "title": "Depth"
        },
        "editions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Edition"
              },
              "maxItems": 12,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Editions sharing version numbers – a record's row for one edition decides only for its builds.",
          "title": "Editions"
        },
        "eol": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "endoflife.date key for release lines and support dates, if it differs from key.",
          "title": "Eol"
        },
        "example": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An example version, shown as placeholder.",
          "title": "Example"
        },
        "filter": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A word a CVE must mention (Hyper-V shares the Windows CPEs); several alternatives separated by | (one of them must be mentioned).",
          "title": "Filter"
        },
        "hint": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of a text in texts.yaml (hints) shown with the product.",
          "title": "Hint"
        },
        "key": {
          "description": "Unique over all files; for an endoflife.date product its key there (e.g. 'nginx').",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
          "title": "Key",
          "type": "string"
        },
        "kw": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Words that find related news.",
          "title": "Kw"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name. Without a label the entry only patches the endoflife.date product of this key.",
          "title": "Label"
        },
        "line_depth": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parts that name a line with its own rows in CVE records (Exchange: 15.2.1748 = 2019 CU15).",
          "title": "Line Depth"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product names in the vendor's advisories.",
          "title": "Names"
        },
        "normalize": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "two_digit_year",
                  "netscaler",
                  "ise_patch",
                  "office_build",
                  "nginx_plus",
                  "checkpoint",
                  "horizon_yymm"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rules that turn display forms into the compared form (app/version_input.py).",
          "title": "Normalize"
        },
        "osv": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[ecosystem, package] in OSV (osv.dev) – an open-source product whose fixed versions OSV adds (by CVE id only).",
          "title": "Osv"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regular expression (Python, whole text, no case) a stored version must match – e.g. Exchange builds only.",
          "title": "Pattern"
        },
        "pattern_hint": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of a text in texts.yaml (hints) shown when a version does not match `pattern`.",
          "title": "Pattern Hint"
        },
        "replaces": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keys this product replaces (duplicates merged into it): an endoflife.date product of such a key is left out, its name found as an alias; follows were moved by a migration.",
          "title": "Replaces"
        },
        "scheme": {
          "anyOf": [
            {
              "enum": [
                "panos",
                "fortios",
                "cisco",
                "windows",
                "vmware",
                "ivanti",
                "veeam",
                "sfos",
                "java",
                "sap",
                "distro",
                "cloud",
                "generic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version scheme (app/vendor_versions.py); default generic.",
          "title": "Scheme"
        },
        "vendor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vendor shown with the product (required with a label).",
          "title": "Vendor"
        },
        "version_cmd": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command (or place) that shows the version.",
          "title": "Version Cmd"
        },
        "where": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of a text in texts.yaml (where) – where the version is read.",
          "title": "Where"
        }
      },
      "required": [
        "key"
      ],
      "title": "Product",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/Product"
  },
  "title": "Products of one category",
  "type": "array"
}
