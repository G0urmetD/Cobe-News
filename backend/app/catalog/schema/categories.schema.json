{
  "$comment": "Generated by `python -m app.catalog_data --write-schema` – do not edit (categories.schema.json)",
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "de": {
          "maxLength": 200,
          "minLength": 1,
          "title": "De",
          "type": "string"
        },
        "en": {
          "maxLength": 200,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "icon": {
          "enum": [
            "activity",
            "app-window",
            "archive-restore",
            "brick-wall",
            "briefcase",
            "cloud",
            "code",
            "container",
            "database",
            "factory",
            "file-badge",
            "globe",
            "hard-drive",
            "key-round",
            "laptop",
            "layers",
            "lock-keyhole",
            "mail",
            "monitor-smartphone",
            "network",
            "package",
            "printer",
            "scan-search",
            "scroll-text",
            "server",
            "shield",
            "split",
            "terminal",
            "ticket",
            "users"
          ],
          "title": "Icon",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "icon",
        "de",
        "en"
      ],
      "title": "Category",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    }
  },
  "required": [
    "categories"
  ],
  "title": "CategoriesFile",
  "type": "object"
}
