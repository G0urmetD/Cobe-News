<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
{#- The weekly review of a team (app/weekly.py) in the mail style of mail.html.j2: tables and inline styles only (mail clients ignore
    <style>). Every value from the feeds arrives as plain text and is escaped here (autoescape). -#}
<body style="margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2330;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ span }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f7;">
<tr><td align="center" style="padding:28px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">

<tr><td style="padding:0 4px 14px;">
  <table role="presentation" cellpadding="0" cellspacing="0"><tr>
    <td style="width:30px;height:30px;background:#3d55d4;border-radius:8px;color:#ffffff;font-weight:700;font-size:15px;text-align:center;vertical-align:middle;">C</td>
    <td style="padding-left:10px;font-size:15px;font-weight:600;color:#1f2330;">Cobe News <span style="color:#7a8094;font-weight:400;">· {{ label }}</span></td>
  </tr></table>
</td></tr>

<tr><td style="background:#ffffff;border:1px solid #e3e5ec;border-radius:12px;overflow:hidden;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr><td style="height:4px;background:#3d55d4;font-size:0;line-height:0;">&nbsp;</td></tr>
    <tr><td style="padding:26px 28px 4px;">
      <p style="margin:0 0 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#3d55d4;font-weight:600;">{{ label }}</p>
      <h1 style="margin:0;font-size:21px;line-height:1.3;font-weight:650;color:#1f2330;">{{ heading }}</h1>
      <p style="margin:6px 0 0;font-size:13px;color:#5b6175;">{{ span }}</p>
    </td></tr>
    {% for s in sections %}
    <tr><td style="padding:16px 28px 4px;">
      <h2 style="margin:0 0 6px;font-size:15px;font-weight:650;color:#1f2330;">{{ s.title }}</h2>
      {% if s.lead %}<p style="margin:0 0 6px;font-size:14px;line-height:1.5;color:#4a5066;">{{ s.lead }}</p>{% endif %}
      {% if s["items"] %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        {% for it in s["items"] %}
        <tr><td style="padding:5px 0;border-top:1px solid #eef0f6;font-size:14px;line-height:1.45;">
          <span style="display:inline-block;width:6px;height:6px;border-radius:3px;background:{{ it.color }};margin-right:6px;"></span>{{ it.text }}{% if it.link %} &nbsp;<a href="{{ it.link }}" style="color:#3d55d4;font-size:13px;">{{ open }}</a>{% endif %}
        </td></tr>
        {% endfor %}
      </table>
      {% endif %}
      {% if s.more_text %}<p style="margin:4px 0 0;font-size:13px;color:#5b6175;">{{ s.more_text }}</p>{% endif %}
    </td></tr>
    {% endfor %}
    <tr><td style="padding:18px 28px 28px;">
      <table role="presentation" cellpadding="0" cellspacing="0"><tr>
        <td style="background:#3d55d4;border-radius:8px;"><a href="{{ url }}" style="display:inline-block;padding:11px 20px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">{{ button }}</a></td>
      </tr></table>
    </td></tr>
  </table>
</td></tr>

<tr><td style="padding:16px 8px 0;font-size:12px;line-height:1.5;color:#7a8094;text-align:center;">
  {% for f in footer %}<p style="margin:0 0 4px;">{{ f }}</p>{% endfor %}
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
