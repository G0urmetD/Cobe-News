<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
{#- The welcome e-mail of a person a team loaded (app/teams.py): German, then English. No password, no token – only the
    address of this installation and how to sign in. Mail clients ignore <style>: tables and inline styles only. -#}
<body style="margin:0;padding:0;background:#f3f4f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2330;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f7;">
<tr><td align="center" style="padding:28px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">

<tr><td style="padding:0 4px 14px;">
  <table role="presentation" cellpadding="0" cellspacing="0"><tr>
    <td style="width:30px;height:30px;background:#3d55d4;border-radius:8px;color:#ffffff;font-weight:700;font-size:15px;text-align:center;vertical-align:middle;">C</td>
    <td style="padding-left:10px;font-size:15px;font-weight:600;color:#1f2330;">Cobe News</td>
  </tr></table>
</td></tr>

<tr><td style="background:#ffffff;border:1px solid #e3e5ec;border-radius:12px;overflow:hidden;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr><td style="height:4px;background:#3d55d4;font-size:0;line-height:0;">&nbsp;</td></tr>
    {% for part in parts %}
    <tr><td lang="{{ part.lang }}" style="padding:{% if loop.first %}26{% else %}10{% endif %}px 28px 18px;{% if not loop.first %}border-top:1px solid #e3e5ec;{% endif %}">
      <h1 style="margin:0 0 12px;font-size:{% if loop.first %}21{% else %}17{% endif %}px;line-height:1.3;font-weight:650;color:#1f2330;">{{ part.heading }}</h1>
      {% for p in part.paragraphs %}<p style="margin:0 0 10px;font-size:14px;line-height:1.55;color:#4a5066;">{{ p }}</p>{% endfor %}
      <p style="margin:14px 0 4px;"><a href="{{ url }}" style="display:inline-block;padding:9px 16px;border-radius:8px;background:#3d55d4;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;">{{ part.button }}</a></p>
      <p style="margin:6px 0 0;font-size:12px;color:#7a8094;">{{ url }}</p>
    </td></tr>
    {% endfor %}
  </table>
</td></tr>

<tr><td style="padding:14px 6px 0;font-size:12px;line-height:1.5;color:#7a8094;">{{ footer }}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
