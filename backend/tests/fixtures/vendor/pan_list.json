  "problem": [
   {
    "lang": "en",
    "value": "A stack-based buffer overflow vulnerability in the log processing functionality of Palo Alto Networks PAN-OS\u00ae software on Panorama enables an attacker to cause a denial of service (DoS) condition. Repeated attempts to trigger this condition result in the Panorama entering maintenance mode.\n\nCloud NGFW, Prisma\u00ae Access, and standalone PAN-OS firewalls are not affected by this vulnerability.\n"
   }
  ],
  "solution": [
   {
    "lang": "eng",
    "value": "VERSION           MINOR VERSION                SUGGESTED SOLUTION\nCloud NGFW                                     No action needed.\nPAN-OS 12.2       12.2.0 through 12.2.3        Upgrade to 12.2.4 or later.\nPAN-OS 12.1       12.1.8 through 12.1.10-h*    Upgrade to 12.1.10-h2 or later.\u00a0\n                  12.1.5 through 12.1.7-h*     Upgrade to 12.1.7-h8 or 12.1.10-h2 or later.\u00a0\n                  12."
   }
  ],
  "work_around": [
   {
    "lang": "eng",
    "value": "The risk posed by this vulnerability can be reduced significantly by limiting access to Panorama to only known good IP addresses."
   }
